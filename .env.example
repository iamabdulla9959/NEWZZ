# PostgreSQL (docker-compose default). Local fallback if Postgres is not installed:
# DATABASE_URL=sqlite:///./newsreels.db
DATABASE_URL=postgresql+psycopg://newsreels:newsreels@localhost:5432/newsreels

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM — Multi-provider client (Gemini → Groq → OpenRouter fallback). Never hardcode keys.
# Primary: Gemini (or any OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=

# Free-tier fallback: Groq
GROQ_API_KEY=

# Secondary fallback: OpenRouter
OPENROUTER_API_KEY=

# News APIs: production ingestion uses only Currents and NewsData.io.
# Daily limits: Currents 250 + NewsData.io 200 = 450 total requests.
CURRENTS_API_KEY=
CURRENTS_INGEST_INTERVAL_MINUTES=30
NEWSDATA_API_KEY=
NEWSDATA_INGEST_INTERVAL_MINUTES=75

# LocationIQ reverse geocoding; keep this server-side, never in the mobile bundle
LOCATIONIQ_API_KEY=
# Optional legacy fallback; the app now defaults to free OpenStreetMap Nominatim reverse geocoding.
# Set this only if you want to use LocationIQ explicitly and it is working for your account.

# Internal admin review UI / API (send as X-Admin-Key)
ADMIN_API_KEY=change-me-local-only

# Worker
INGEST_INTERVAL_SECONDS=900
CLUSTER_SIMILARITY_THRESHOLD=0.85
SINGLE_SOURCE_DISCLAIMER_AFTER_MINUTES=45

# API server
API_HOST=0.0.0.0
API_PORT=8000

# CORS: comma-separated allowed origins. Use '*' for local development.
# In production, set to your actual domain(s): CORS_ORIGINS=https://yourdomain.com
CORS_ORIGINS=*

# NewsAPI.org — DEV / LOCAL TESTING ONLY (Free tier terms forbid commercial / production use)
# Must explicitly set ENABLE_NEWSAPI_DEV_SOURCE=true to enable polling in dev
ENABLE_NEWSAPI_DEV_SOURCE=false
NEWSAPI_API_KEY=
