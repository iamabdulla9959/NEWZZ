# PostgreSQL (docker-compose default). Local fallback if Postgres is not installed:
# DATABASE_URL=sqlite:///./newsreels.db
DATABASE_URL=postgresql+psycopg://newsreels:newsreels@localhost:5432/newsreels

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM — OpenAI-compatible client (Gemini / Groq / other). Never hardcode keys.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash

# NewsData.io free tier
NEWSDATA_API_KEY=

# Internal admin review UI / API (send as X-Admin-Key)
ADMIN_API_KEY=change-me-local-only

# Worker
INGEST_INTERVAL_SECONDS=900
CLUSTER_SIMILARITY_THRESHOLD=0.85
SINGLE_SOURCE_DISCLAIMER_AFTER_MINUTES=45

# API
API_HOST=0.0.0.0
API_PORT=8000

# NewsAPI.org — DEV / LOCAL TESTING ONLY (Free tier terms forbid commercial / production use)
# Must explicitly set ENABLE_NEWSAPI_DEV_SOURCE=true to enable polling in dev
ENABLE_NEWSAPI_DEV_SOURCE=false
NEWSAPI_API_KEY=
